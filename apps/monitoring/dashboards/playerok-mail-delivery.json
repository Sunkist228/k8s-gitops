{
  "uid": "playerok-mail-delivery",
  "title": "Playerok Mail Delivery",
  "description": "Очередь email-worker, результаты отправки, дневная квота, задержки и связанные endpoint аутентификации.",
  "tags": ["playerok", "email-worker", "mail", "authentication"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1, "title": "Email worker target", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(up{namespace=\"playerok-dev\",service=\"email-worker-metrics\"}) or vector(0)", "legendFormat": "up", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 2, "title": "Pending and retrying", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(devflux_email_queue_depth{namespace=\"playerok-dev\",status=~\"pending|retrying\"}) or vector(0)", "legendFormat": "queued", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 25}, {"color": "red", "value": 100}]}}}
    },
    {
      "id": 3, "title": "Oldest queued message", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(devflux_email_queue_oldest_seconds{namespace=\"playerok-dev\"}) or vector(0)", "legendFormat": "age", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 300}, {"color": "red", "value": 900}]}}}
    },
    {
      "id": 4, "title": "Daily reserved", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(devflux_email_daily_reserved{namespace=\"playerok-dev\"}) or vector(0)", "legendFormat": "reserved", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 5, "title": "Daily remaining", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "clamp_min(max(devflux_email_daily_limit{namespace=\"playerok-dev\"}) - max(devflux_email_daily_reserved{namespace=\"playerok-dev\"}),0) or vector(0)", "legendFormat": "remaining", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 6, "title": "Mail firing alerts", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(ALERTS{alertstate=\"firing\",alertname=~\"PlayerokEmail.*|Stalwart.*\"}) or vector(0)", "legendFormat": "alerts", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 7, "title": "Queue depth by status", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "devflux_email_queue_depth{namespace=\"playerok-dev\"}", "legendFormat": "{{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 8, "title": "Worker outcomes", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 4},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (result) (rate(devflux_email_worker_results_total{namespace=\"playerok-dev\"}[$__rate_interval]))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}
    },
    {
      "id": 9, "title": "Daily quota usage", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(devflux_email_daily_reserved{namespace=\"playerok-dev\"})", "legendFormat": "reserved", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(devflux_email_daily_limit{namespace=\"playerok-dev\"})", "legendFormat": "limit", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 10, "title": "Oldest message age", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(devflux_email_queue_oldest_seconds{namespace=\"playerok-dev\"})", "legendFormat": "oldest", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    },
    {
      "id": 11, "title": "Email-related authentication traffic", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (handler,status) (rate(http_requests_total{namespace=\"playerok-dev\",service=\"backend\",handler=~\"/api/v1/auth/.*(email|verify|password|register).*\"}[$__rate_interval]))", "legendFormat": "{{handler}} {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 12, "title": "Email-related endpoint latency", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95,sum by (handler,le) (rate(http_request_duration_seconds_bucket{namespace=\"playerok-dev\",service=\"backend\",handler=~\"/api/v1/auth/.*(email|verify|password|register).*\"}[$__rate_interval])))", "legendFormat": "{{handler}} p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    },
    {
      "id": 13, "title": "Email worker CPU and memory", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 29},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"playerok-dev\",pod=~\"email-worker-.*\",container=\"email-worker\"}[$__rate_interval]))", "legendFormat": "CPU cores", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(container_memory_working_set_bytes{namespace=\"playerok-dev\",pod=~\"email-worker-.*\",container=\"email-worker\"})", "legendFormat": "memory bytes", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"min": 0}}
    },
    {
      "id": 14, "title": "Worker replicas and restarts", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 29},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "kube_deployment_status_replicas_available{namespace=\"playerok-dev\",deployment=\"email-worker\"}", "legendFormat": "available", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"playerok-dev\",pod=~\"email-worker-.*\",container=\"email-worker\"}[24h]))", "legendFormat": "restarts 24h", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 15, "title": "Worker network throughput", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 29},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"playerok-dev\",pod=~\"email-worker-.*\"}[$__rate_interval]))", "legendFormat": "RX", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"playerok-dev\",pod=~\"email-worker-.*\"}[$__rate_interval]))", "legendFormat": "TX", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}}
    }
  ]
}
