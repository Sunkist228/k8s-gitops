{
  "uid": "playerok-artifacts",
  "title": "Playerok Artifact Server",
  "description": "Полный контроль артефактов: загрузки, скачивания, публикация, хранилище, retention, HTTP и ресурсы.",
  "tags": ["playerok", "artifact-server", "storage"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1, "title": "Artifact target", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(up{namespace=\"playerok-dev\",service=\"artifact-server\"}) or vector(0)", "legendFormat": "up", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 2, "title": "Storage used", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(artifact_storage_used_bytes{namespace=\"playerok-dev\"}) or vector(0)", "legendFormat": "used", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}}
    },
    {
      "id": 3, "title": "Downloads in range", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(artifact_download_total{namespace=\"playerok-dev\"}[$__range])) or vector(0)", "legendFormat": "downloads", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 4, "title": "Uploads in range", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(artifact_upload_total{namespace=\"playerok-dev\"}[$__range])) or vector(0)", "legendFormat": "uploads", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 5, "title": "Storage errors in range", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(artifact_storage_error_total{namespace=\"playerok-dev\"}[$__range])) or vector(0)", "legendFormat": "errors", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 6, "title": "Artifact firing alerts", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(ALERTS{alertstate=\"firing\",alertname=~\"PlayerokArtifact.*\"}) or vector(0)", "legendFormat": "alerts", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 7, "title": "Downloads by artifact", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (slug,platform,arch,mode) (rate(artifact_download_total{namespace=\"playerok-dev\"}[$__rate_interval]))", "legendFormat": "{{slug}} {{platform}}/{{arch}} {{mode}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 8, "title": "Uploads by result", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 4},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (project,slug,platform,arch,result) (rate(artifact_upload_total{namespace=\"playerok-dev\"}[$__rate_interval]))", "legendFormat": "{{project}}/{{slug}} {{platform}}/{{arch}} {{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 9, "title": "Promotions by channel and result", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (project,slug,channel,platform,arch,result) (rate(artifact_promote_total{namespace=\"playerok-dev\"}[$__rate_interval]))", "legendFormat": "{{project}}/{{slug}} {{channel}} {{platform}}/{{arch}} {{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 10, "title": "Storage errors by operation", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (operation) (increase(artifact_storage_error_total{namespace=\"playerok-dev\"}[$__interval]))", "legendFormat": "{{operation}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 11, "title": "Retention runs", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 21},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (trigger,result) (increase(artifact_retention_runs_total{namespace=\"playerok-dev\"}[$__interval]))", "legendFormat": "{{trigger}} {{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 12, "title": "Retention deleted bytes", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 21},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (mode) (increase(artifact_retention_deleted_bytes_total{namespace=\"playerok-dev\"}[$__interval]))", "legendFormat": "{{mode}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}}
    },
    {
      "id": 13, "title": "Retention health", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 21},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "time() - max(artifact_retention_last_run_timestamp{namespace=\"playerok-dev\"})", "legendFormat": "seconds since run", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(artifact_retention_errors_total{namespace=\"playerok-dev\"}[$__interval]))", "legendFormat": "errors", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"min": 0}}
    },
    {
      "id": 14, "title": "HTTP traffic by endpoint and status", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (handler,method,status) (rate(http_requests_total{namespace=\"playerok-dev\",service=\"artifact-server\"}[$__rate_interval]))", "legendFormat": "{{method}} {{handler}} {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 15, "title": "HTTP latency p50/p95/p99", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50,sum by (handler,le) (rate(http_request_duration_seconds_bucket{namespace=\"playerok-dev\",service=\"artifact-server\"}[$__rate_interval])))", "legendFormat": "{{handler}} p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95,sum by (handler,le) (rate(http_request_duration_seconds_bucket{namespace=\"playerok-dev\",service=\"artifact-server\"}[$__rate_interval])))", "legendFormat": "{{handler}} p95", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99,sum by (handler,le) (rate(http_request_duration_seconds_bucket{namespace=\"playerok-dev\",service=\"artifact-server\"}[$__rate_interval])))", "legendFormat": "{{handler}} p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    },
    {
      "id": 16, "title": "Artifact pod resources", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"playerok-dev\",pod=~\"artifact-server-.*\",container=\"artifact-server\"}[$__rate_interval]))", "legendFormat": "CPU cores", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(container_memory_working_set_bytes{namespace=\"playerok-dev\",pod=~\"artifact-server-.*\",container=\"artifact-server\"})", "legendFormat": "memory bytes", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"playerok-dev\",pod=~\"artifact-server-.*\",container=\"artifact-server\"}[24h]))", "legendFormat": "restarts 24h", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"min": 0}}
    },
    {
      "id": 17, "title": "Artifact network throughput", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"playerok-dev\",pod=~\"artifact-server-.*\"}[$__rate_interval]))", "legendFormat": "RX", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"playerok-dev\",pod=~\"artifact-server-.*\"}[$__rate_interval]))", "legendFormat": "TX", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}}
    }
  ]
}
