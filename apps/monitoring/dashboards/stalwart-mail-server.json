{
  "uid": "stalwart-mail-server",
  "title": "Stalwart Mail Server",
  "description": "Stalwart: доступность экспортера, StatefulSet, pod, хранилище, сеть и прикладные метрики почтовых протоколов.",
  "tags": ["mail", "stalwart", "smtp", "imap"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "stalwart_metric",
        "label": "Raw Stalwart metric",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values({namespace=\"mail\",service=\"mail-stalwart\"}, __name__)",
        "multi": true,
        "includeAll": false,
        "refresh": 1,
        "current": {"selected": true, "text": ["smtp_active_connections"], "value": ["smtp_active_connections"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "Stalwart metrics target", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(up{namespace=\"mail\",service=\"mail-stalwart\"}) or vector(0)", "legendFormat": "up", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 2, "title": "Ready replicas", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(kube_statefulset_status_replicas_ready{namespace=\"mail\",statefulset=\"mail-stalwart\"}) or vector(0)", "legendFormat": "ready", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 3, "title": "Pod ready", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(kube_pod_status_ready{namespace=\"mail\",pod=~\"mail-stalwart-.*\",condition=\"true\"}) or vector(0)", "legendFormat": "ready", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 4, "title": "Scraped samples", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(scrape_samples_scraped{namespace=\"mail\",service=\"mail-stalwart\"}) or vector(0)", "legendFormat": "samples", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 5, "title": "Restarts in 24h", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"mail\",pod=~\"mail-stalwart-.*\",container=\"stalwart\"}[24h])) or vector(0)", "legendFormat": "restarts", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 3}]}}}
    },
    {
      "id": 6, "title": "Stalwart firing alerts", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(ALERTS{alertstate=\"firing\",alertname=~\"Stalwart.*\"}) or vector(0)", "legendFormat": "alerts", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 7, "title": "CPU usage", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 4},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"mail\",pod=~\"mail-stalwart-.*\",container=\"stalwart\"}[$__rate_interval]))", "legendFormat": "{{pod}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "cores", "min": 0}}
    },
    {
      "id": 8, "title": "Memory working set", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 4},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"mail\",pod=~\"mail-stalwart-.*\",container=\"stalwart\"})", "legendFormat": "{{pod}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}}
    },
    {
      "id": 9, "title": "Network throughput", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 4},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"mail\",pod=~\"mail-stalwart-[0-9]+\"}[$__rate_interval]))", "legendFormat": "{{pod}} RX", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"mail\",pod=~\"mail-stalwart-[0-9]+\"}[$__rate_interval]))", "legendFormat": "{{pod}} TX", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}}
    },
    {
      "id": 10, "title": "Persistent volume requested capacity", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (persistentvolumeclaim) (kube_persistentvolumeclaim_resource_requests_storage_bytes{namespace=\"mail\",persistentvolumeclaim=~\"mail-stalwart-data|mail-stalwart-config\"})", "legendFormat": "{{persistentvolumeclaim}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}}
    },
    {
      "id": 11, "title": "Persistent volume Bound status", "type": "stat", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (persistentvolumeclaim) (kube_persistentvolumeclaim_status_phase{namespace=\"mail\",persistentvolumeclaim=~\"mail-stalwart-data|mail-stalwart-config\",phase=\"Bound\"})", "legendFormat": "{{persistentvolumeclaim}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 12, "title": "Prometheus scrape health", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "scrape_duration_seconds{namespace=\"mail\",service=\"mail-stalwart\"}", "legendFormat": "duration", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "scrape_samples_scraped{namespace=\"mail\",service=\"mail-stalwart\"}", "legendFormat": "samples", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "scrape_series_added{namespace=\"mail\",service=\"mail-stalwart\"}", "legendFormat": "series added", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"min": 0}}
    },
    {
      "id": 13, "title": "StatefulSet generations", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(kube_statefulset_metadata_generation{namespace=\"mail\",statefulset=\"mail-stalwart\"})", "legendFormat": "desired generation", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(kube_statefulset_status_observed_generation{namespace=\"mail\",statefulset=\"mail-stalwart\"})", "legendFormat": "observed generation", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(kube_statefulset_status_replicas_ready{namespace=\"mail\",statefulset=\"mail-stalwart\"})", "legendFormat": "ready replicas", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 14, "title": "Users and domains", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 28},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(user_count{namespace=\"mail\",service=\"mail-stalwart\"}) or vector(0)", "legendFormat": "users", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(domain_count{namespace=\"mail\",service=\"mail-stalwart\"}) or vector(0)", "legendFormat": "domains", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 15, "title": "Stalwart application memory", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 28},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(server_memory{namespace=\"mail\",service=\"mail-stalwart\"}) or vector(0)", "legendFormat": "memory", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}}
    },
    {
      "id": 16, "title": "Active protocol connections", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(smtp_active_connections{namespace=\"mail\",service=\"mail-stalwart\"})", "legendFormat": "SMTP", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(imap_active_connections{namespace=\"mail\",service=\"mail-stalwart\"})", "legendFormat": "IMAP", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(pop3_active_connections{namespace=\"mail\",service=\"mail-stalwart\"})", "legendFormat": "POP3", "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(sieve_active_connections{namespace=\"mail\",service=\"mail-stalwart\"})", "legendFormat": "ManageSieve", "refId": "D"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(http_active_connections{namespace=\"mail\",service=\"mail-stalwart\"})", "legendFormat": "HTTP/JMAP", "refId": "E"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(delivery_active_connections{namespace=\"mail\",service=\"mail-stalwart\"})", "legendFormat": "delivery", "refId": "F"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 17, "title": "IMAP protocol activity", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 36},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(imap_connection_start{namespace=\"mail\",service=\"mail-stalwart\"}[$__rate_interval]))", "legendFormat": "connections/s", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(imap_my_rights{namespace=\"mail\",service=\"mail-stalwart\"}[$__rate_interval]))", "legendFormat": "MYRIGHTS/s", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}
    },
    {
      "id": 18, "title": "Authentication and SPF", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 36},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(auth_warning{namespace=\"mail\",service=\"mail-stalwart\"}[$__rate_interval]))", "legendFormat": "auth warnings/s", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(spf_pass{namespace=\"mail\",service=\"mail-stalwart\"}[$__rate_interval]))", "legendFormat": "SPF pass/s", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(spf_temp_error{namespace=\"mail\",service=\"mail-stalwart\"}[$__rate_interval]))", "legendFormat": "SPF temp errors/s", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}
    },
    {
      "id": 19, "title": "Stalwart HTTP latency", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 36},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50,sum by (le) (rate(http_request_time_bucket{namespace=\"mail\",service=\"mail-stalwart\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95,sum by (le) (rate(http_request_time_bucket{namespace=\"mail\",service=\"mail-stalwart\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99,sum by (le) (rate(http_request_time_bucket{namespace=\"mail\",service=\"mail-stalwart\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    },
    {
      "id": 20, "title": "Unexpected store errors", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 44},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(store_unexpected_error{namespace=\"mail\",service=\"mail-stalwart\"}[$__interval])) or vector(0)", "legendFormat": "errors", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 21, "title": "Raw metric explorer", "type": "timeseries", "gridPos": {"h": 8, "w": 16, "x": 8, "y": 44},
      "description": "Выберите одну или несколько серий в переменной Raw Stalwart metric. Новые метрики exporter появляются здесь автоматически.",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "{__name__=~\"$stalwart_metric\",namespace=\"mail\",service=\"mail-stalwart\"}", "legendFormat": "{{__name__}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0}}
    }
  ]
}
